{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; The OS layer: the Java port's platform project, as a jar.
        ;; Build it first with: java/gradlew.bat -p java :platform:jar
        whereami/platform {:local/root "../java/platform/build/libs/platform.jar"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clojure -T:build uber
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}}}
