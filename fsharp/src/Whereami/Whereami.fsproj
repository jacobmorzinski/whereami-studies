<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Plain net10.0 runs on any OS; the -windows target adds the WinRT projection and the WINDOWS symbol. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Lets non-Windows hosts restore the Windows target; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>whereami</AssemblyName>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <!-- F# compiles files in this order: each file can only use the ones above it. -->
  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="Platform.fs" />
    <Compile Include="Windows.fs" />
    <Compile Include="GeoClue.fs" />
    <Compile Include="Linux.fs" />
    <Compile Include="Native.fs" />
    <Compile Include="CommandLine.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whereami.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <!-- Classic Tmds.DBus (runtime-generated proxies) for the Linux GeoClue2 backend;
         the Windows build has no D-Bus code. -->
    <PackageReference Include="Tmds.DBus" Version="0.95.2" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
