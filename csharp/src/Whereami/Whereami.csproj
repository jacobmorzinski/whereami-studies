<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 runs anywhere; the -windows10.0.19041.0 target adds the
         WinRT projection (Windows.* namespaces) and defines WINDOWS. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Lets non-Windows hosts restore the Windows target; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>whereami</AssemblyName>
    <RootNamespace>Whereami</RootNamespace>
    <Version>0.4.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whereami.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <!-- Classic Tmds.DBus (runtime-generated proxies) for the Linux GeoClue2 backend;
         the Windows build neither references nor compiles any D-Bus code. -->
    <PackageReference Include="Tmds.DBus" Version="0.95.2" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
